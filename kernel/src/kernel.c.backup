#include <kernel/hal/serial.h>
#include <kernel/hal/port_io.h>
#include <kernel/interrupts/idt.h>
#include <kernel/interrupts/pic.h>
#include <kernel/interrupts/interrupt_frame.h>
#include <kernel/printk.h>
#include <kernel/module.h>
#include <kernel/gdt.h>

// Заглушки для тестовых функций модуля
static int test_module_init(void) { return 0; }
static int test_module_deinit(void) { return 0; }
static int test_module_run_tests(void) { return 0; }

void test_handler(interrupt_frame_t* frame) {
    printk("Test interrupt handled! IRQ: %d\n", frame->int_no);
}

void kernel_main() {
    serial_init();
    printk("Serial initialized\n");

    init_gdt();
    printk("GDT initialized\n");

    idt_init();
    printk("IDT initialized\n");

    // Перенастраиваем PIC
    pic_remap(0x20, 0x28);
    printk("PIC remapped\n");

    // Регистрация обработчика
    register_interrupt_handler(0x30, test_handler);

    // Разрешаем прерывания
    __asm__ volatile("sti");
    printk("Interrupts enabled\n");

    // Вызов тестового прерывания
    printk("Triggering test interrupt\n");
    __asm__ volatile("int $0x30");

    // Инициализация системы модулей
    printk("Initializing module system...\n");
    module_init_system();
    printk("Module system initialized\n");

    // Тестовая загрузка модулей
    printk("\n=== Testing module loading ===\n");

    // Загрузка тестового модуля с передачей всех необходимых параметров
    int ret = module_load("test_module", test_module_init, test_module_deinit, test_module_run_tests);
    if (ret == 0) {
        printk("Test module loaded successfully!\n");
    } else {
        printk("Failed to load test module! Error: %d\n", ret);
    }

    // Попытка загрузить несуществующий модуль (передаем NULL для функций)
    ret = module_load("non_existent_module", NULL, NULL, NULL);
    if (ret == 0) {
        printk("Non-existent module loaded?! This shouldn't happen!\n");
    } else {
        printk("Correctly failed to load non-existent module. Error: %d\n", ret);
    }

    // Выводим список загруженных модулей
    printk("\nCurrent loaded modules:\n");
    module_print_loaded();

    // Выгружаем тестовый модуль
    printk("\nUnloading test module...\n");
    ret = module_unload("test_module");
    if (ret == 0) {
        printk("Test module unloaded successfully!\n");
    } else {
        printk("Failed to unload test module! Error: %d\n", ret);
    }

    // Снова выводим список модулей
    printk("\nLoaded modules after unloading:\n");
    module_print_loaded();

    printk("\n=== Module testing complete ===\n");
    printk("Kernel initialized. Entering main loop\n");

    while(1) {
        __asm__ volatile("hlt");
    }
}
